/// Secondary what-if parameter table providing the full volume range simultaneously for break-even chart rendering. Used only by Buy Scenario Full Cost (All). Note: this measure omits yield rate adjustment — see measure description. No temporal dimension — this model has no date or time columns.
table 'Scenario Volumes (All)'
	lineageTag: 81738127-dbf5-4981-b36a-2132197b6b40

	/// Buy scenario cost across all scenario volumes simultaneously (used in the break-even line chart). Unlike Buy Scenario Full Cost, this measure does not apply Yield Rate adjustment — it uses raw Unit Cost × Volume. Used for the sensitivity analysis visual only.
	measure 'Buy Scenario Full Cost (All)' =
			VAR ScenarioVol = MIN('Scenario Volumes (All)'[Scenario Volume])
			VAR BuyCostAll =
			    MINX(
			        FILTER(fact_Quotes, fact_Quotes[Volume] <= ScenarioVol),
			        ScenarioVol * fact_Quotes[Unit_Cost] + fact_Quotes[Non_recurring_expenses]
			    )
			RETURN
			    BuyCostAll
		displayFolder: Buy Scenario
		lineageTag: b613b89c-c35a-4d7f-8997-61df3f8d129d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Scenario Volume'
		formatString: 0
		lineageTag: 5e164911-0d98-478b-9b3c-13cb420cb1fe
		summarizeBy: sum
		isNameInferred
		sourceColumn: Scenario Volume[Scenario Volume]
		columnOrigin: 'Scenario Volume'.'Scenario Volume'

		annotation SummarizationSetBy = Automatic

	partition 'Scenario Volumes (All)-c0fdd03f-ed67-4dac-a7c4-4fefcd3fedf7' = calculated
		mode: import
		source = 'Scenario Volume'

	annotation PBI_Id = 2ae029fac3e740889ef11629bfa96246

