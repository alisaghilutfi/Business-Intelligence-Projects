table 'Scenario Volumes (All)'
	lineageTag: 81738127-dbf5-4981-b36a-2132197b6b40

	measure 'Buy Scenario Full Cost (All)' = MINX(FILTER(Quotes, Quotes[Volume] <= MIN('Scenario Volumes (All)'[Scenario Volume])), MIN('Scenario Volumes (All)'[Scenario Volume]) * Quotes[Unit_Cost] + Quotes[Non_recurring_expenses])
