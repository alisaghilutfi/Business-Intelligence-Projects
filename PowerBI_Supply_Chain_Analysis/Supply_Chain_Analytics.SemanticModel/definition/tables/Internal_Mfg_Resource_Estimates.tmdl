table Internal_Mfg_Resource_Estimates
	lineageTag: d172ab30-c789-4266-a064-9b8c6c57d729

	measure 'Additional Unit Capacity Required' = MINX(Internal_Mfg_Resource_Estimates, MAX('Scenario Volume'[Scenario Volume Value] - Internal_Mfg_Resource_Estimates[Existing_Capacity],0))
		formatString: #,0
		lineageTag: bd6f7f1c-ea35-42c0-a48d-61643aa81762

		changedProperty = FormatString

	measure 'Capital Investment Required (Make)' = MINX(Internal_Mfg_Resource_Estimates, ROUNDUP([Additional Unit Capacity Required] / MIN(Internal_Mfg_Resource_Estimates[Unit_Capacity]),0) * Internal_Mfg_Resource_Estimates[Machine_Fixed_Cost])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: c438dfa5-fb2a-443d-ba36-927d816bca07

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Make Scenario Full Cost' = MINX(Internal_Mfg_Resource_Estimates, [Capital Investment Required (Make)] + Internal_Mfg_Resource_Estimates[Cost_per_Unit] * 'Scenario Volume'[Scenario Volume Value])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 246502bf-ba91-4b63-9ca1-a0d18200e9cf

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

