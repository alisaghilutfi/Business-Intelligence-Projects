/// Fact table. One row per line item sold (product × customer × invoice). Grain: Stock Code × Invoice No × Transaction Date. Contains quantity, sales revenue, unit price, shipping cost, COGS, and profit. ~500K rows, Dec 2020–Dec 2021 (Whiskique fictitious dataset).
table fact_Sales
	lineageTag: 24ef9dec-5759-49ec-a242-42b449b59d51

	/// Total number of rows in fact_Sales. Used for data validation and QA checks.
	measure Total_Rows =
			VAR RowCount = COUNTROWS(fact_Sales)
			RETURN
			    RowCount
		formatString: 0
		displayFolder: Diagnostics
		lineageTag: 79c9501f-3df4-4eae-918e-964111d1b487

	/// Baseline shipping cost using a tiered model: first unit at full cost, each additional unit at 70% of unit shipping cost. This is the pre-optimisation benchmark.
	measure 'Shipping (Baseline)' =
			VAR ShippingBaseline =
			    SUMX(
			        fact_Sales,
			        IF(
			            fact_Sales[Quantity] = 1,
			            fact_Sales[Shipping Cost],
			            fact_Sales[Shipping Cost] + (((fact_Sales[Quantity]) - 1) * (fact_Sales[Shipping Cost] * 0.7))
			        )
			    )
			RETURN
			    ShippingBaseline
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Shipping
		lineageTag: 4ce7fb25-dc74-4ef0-a16f-43f7d3665a53

	/// Projected shipping cost under the what-if blended cost factor parameter. Additional units beyond the first are discounted by the factor from the What-if quantity slicer.
	measure 'Shipping (What-if)' =
			VAR ShippingWhatIf =
			    SUMX(
			        fact_Sales,
			        IF(
			            fact_Sales[Quantity] = 1,
			            fact_Sales[Shipping Cost],
			            fact_Sales[Shipping Cost] + (((fact_Sales[Quantity]) - 1) * (fact_Sales[Shipping Cost] * [Blended Shipping Cost Factor]))
			        )
			    )
			RETURN
			    ShippingWhatIf
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Shipping
		lineageTag: ee19cd41-4ec2-440d-b4c3-2507217420cb

	/// Potential shipping cost saving from consolidation: Shipping (Baseline) minus Shipping (What-if). Positive values indicate cost reduction under the what-if scenario.
	measure 'Shipping (Difference)' =
			VAR Baseline = [Shipping (Baseline)]
			VAR WhatIf = [Shipping (What-if)]
			RETURN
			    Baseline - WhatIf
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Shipping
		lineageTag: 07a4163c-1136-472a-a802-5f7a0d694757

	/// Cumulative baseline shipping cost up to the current date in context, using ALLSELECTED(fact_Sales) to respect page-level filters while ignoring visual-level date filters. Date boundary is driven by fact_Market_Baskets[Transaction Date].
	measure 'Baseline running total' =
			VAR CurrentDate = MAX(fact_Market_Baskets[Transaction Date])
			VAR RunningTotal =
			    SUMX(
			        FILTER(
			            ALLSELECTED(fact_Sales),
			            fact_Sales[Transaction Date] <= CurrentDate
			        ),
			        [Shipping (Baseline)]
			    )
			RETURN
			    RunningTotal
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Shipping
		lineageTag: dc4b5dbc-da47-46c9-b51f-acb6f2517902

	/// Cumulative what-if shipping cost up to the current date in context, using ALLSELECTED(fact_Sales) to respect page-level filters while ignoring visual-level date filters. Date boundary is driven by fact_Market_Baskets[Transaction Date].
	measure 'What-if running total' =
			VAR CurrentDate = MAX(fact_Market_Baskets[Transaction Date])
			VAR RunningTotal =
			    SUMX(
			        FILTER(
			            ALLSELECTED(fact_Sales),
			            fact_Sales[Transaction Date] <= CurrentDate
			        ),
			        [Shipping (What-if)]
			    )
			RETURN
			    RunningTotal
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Shipping
		lineageTag: af65176d-21ed-402c-ab22-d39bd7da29bf

	/// Cumulative shipping cost saving (Baseline minus What-if) up to the current date in context. Uses ALLSELECTED(fact_Sales) — respects page filters, ignores visual date axis. Date boundary driven by fact_Market_Baskets[Transaction Date].
	measure 'Difference running total' =
			VAR CurrentDate = MAX(fact_Market_Baskets[Transaction Date])
			VAR RunningTotal =
			    SUMX(
			        FILTER(
			            ALLSELECTED(fact_Sales),
			            fact_Sales[Transaction Date] <= CurrentDate
			        ),
			        [Shipping (Difference)]
			    )
			RETURN
			    RunningTotal
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Shipping
		lineageTag: 3fcbc3e7-adc5-467b-83b3-5bd3f93c8944

