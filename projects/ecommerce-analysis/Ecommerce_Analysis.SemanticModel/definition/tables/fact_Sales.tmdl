		annotation SummarizationSetBy = Automatic

	column 'Profit (Baseline)' = fact_Sales[Sales]-fact_Sales[COGS]-[Shipping (Baseline)]
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: bbfcb7bb-b230-41b5-aa4d-03ea572ad322
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

