/// Fact table. One row per supplier quote (Part_Number × Supplier × Volume tier). Contains unit cost, non-recurring expenses, volume break point, and yield rate. Source: external supplier quote sheets (Widgetmakers Inc fictitious dataset). No temporal dimension — this model has no date or time columns.
table fact_Quotes
	lineageTag: 805206a2-3fd5-427a-b85d-7069edec04c8

	column Supplier
		dataType: string
		isHidden
		lineageTag: 9db5b732-35d3-4bbc-99da-fafae7a309c3
		summarizeBy: none
		sourceColumn: Supplier

		annotation SummarizationSetBy = Automatic

	column Part_Number
		dataType: string
		isHidden
		lineageTag: 4c6ce8b7-5da1-4b51-9e4d-83c588eeefa2
		summarizeBy: none
		sourceColumn: Part_Number

		annotation SummarizationSetBy = Automatic

	column Volume
		dataType: int64
		formatString: 0
		lineageTag: ec13026b-09db-43c0-b0b7-8c493b8b18f5
		summarizeBy: none
		sourceColumn: Volume

		annotation SummarizationSetBy = User

	column Non_recurring_expenses
		dataType: double
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: e438bdee-54de-45e5-82d2-e4d722e85ecb
		summarizeBy: sum
		sourceColumn: Non_recurring_expenses

		changedProperty = FormatString

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	column Unit_Cost
		dataType: double
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 5e825c93-03a4-436b-a2fb-c6b4c703eccd
		summarizeBy: none
		sourceColumn: Unit_Cost

		changedProperty = FormatString

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	column Quote_ID
		dataType: string
		lineageTag: 4300d987-2ebd-455a-a5da-34d9666b2df8
		summarizeBy: none
		sourceColumn: Quote_ID

		annotation SummarizationSetBy = Automatic

	column 'Extended Cost' = fact_Quotes[Unit_Cost] * fact_Quotes[Volume]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 8177616b-3c42-491b-8576-054d4e13aeb1
		summarizeBy: none

		changedProperty = FormatString

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	column 'Full Cost' = fact_Quotes[Extended Cost] + fact_Quotes[Non_recurring_expenses]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: cb3c05c8-2766-4b65-8e1d-95df1e5784ee
		summarizeBy: none

		changedProperty = FormatString

		annotation SummarizationSetBy = User

	column 'Yield Rate' = FIRSTNONBLANK('dim_Yield_Rate'[Yield Rate], TRUE)
		lineageTag: 3a4cc3bb-c5f5-4524-b3b8-ab6c6dca186d
		summarizeBy: sum

