{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.7.0/schema.json",
  "name": "p2_variance_bars",
  "position": {
    "x": 104,
    "y": 248,
    "z": 1000,
    "height": 400,
    "width": 1216,
    "tabOrder": 7
  },
  "visual": {
    "visualType": "barChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_Product"
                    }
                  },
                  "Property": "SubCategory"
                }
              },
              "queryRef": "dim_Product.SubCategory",
              "nativeQueryRef": "Sub-Category",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Sales YoY$"
                }
              },
              "queryRef": "_Measures.Sales YoY$",
              "nativeQueryRef": "Sales YoY$"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          {
            "field": {
              "Measure": {
                "Expression": {
                  "SourceRef": {
                    "Entity": "_Measures"
                  }
                },
                "Property": "Sales YoY$"
              }
            },
            "direction": "Descending"
          }
        ],
        "isDefaultSort": true
      }
    },
    "drillFilterOtherVisuals": true
  }
}
