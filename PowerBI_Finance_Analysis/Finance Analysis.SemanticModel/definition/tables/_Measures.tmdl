table _Measures
	lineageTag: f5947bb5-124e-4a5f-923f-429f51dbdbfe

	/// Sum of all transaction amounts in the current filter context. Amounts are absolute values (negatives converted at source). Does not exclude any transaction status — apply a Transaction Status filter to isolate completed transactions.
	measure 'Total Amount' = SUM(fact_Transactions[Amount])
		displayFolder: Totals
		lineageTag: f3e6dad0-0824-481b-be3e-3f44f1ee52a1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Count of transaction records by date in the current filter context. Counts all statuses including failed and pending. Use with a Transaction Status slicer to isolate successful transactions.
	measure 'Total Transactions' = COUNT(fact_Transactions[Transaction Date])
		formatString: 0
		displayFolder: Totals
		lineageTag: 4c083541-2031-4ed9-b87f-d1c4a5d9e91d

	/// Average transaction amount per transaction in the current filter context. Based on absolute values. Sensitive to mix of transaction types and segments in the filter context.
	measure 'Average Transaction Value' = AVERAGE(fact_Transactions[Amount])
		displayFolder: Totals
		lineageTag: a6d6744d-0f33-49c6-8921-363eebcbf84d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Sum of fee amounts charged on transactions in the current filter context. Null fees were replaced with 14.52 at source — this default value is included in totals.
	measure 'Total Fees' = SUM(fact_Transactions[Fee Amount])
		displayFolder: Totals
		lineageTag: 01ac1a0d-dfbc-4fca-b620-7e9bcf04f320

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Sum of tax amounts on transactions in the current filter context. Reflects tax as recorded at transaction level; does not adjust for any tax reclaim or correction.
	measure 'Total Tax' = SUM(fact_Transactions[Tax Amount])
		displayFolder: Totals
		lineageTag: f6fa96a6-cd48-4b37-a76b-a0606744da09

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Total Amount for the same period in the prior year using SAMEPERIODLASTYEAR. Returns blank if no prior-year dates exist in dim_Date or if the date range is outside 2023–2026.
	measure 'PY Amount' = CALCULATE([Total Amount], SAMEPERIODLASTYEAR('dim_Date'[Date]))
		formatString: 0
		displayFolder: PYs
		lineageTag: 911acd33-7e7c-4cab-a2fb-96763c5975bb

	/// Total Fees for the same period in the prior year using SAMEPERIODLASTYEAR. Returns blank if prior-year dates are outside the dim_Date range.
	measure 'PY Fees' = CALCULATE([Total Fees], SAMEPERIODLASTYEAR('dim_Date'[Date]))
		displayFolder: PYs
		lineageTag: 609eaaca-5da6-40fd-a859-69300a94bf35

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Total Tax for the same period in the prior year using SAMEPERIODLASTYEAR. Returns blank if prior-year dates are outside the dim_Date range.
	measure 'PY Tax' = CALCULATE([Total Tax], SAMEPERIODLASTYEAR('dim_Date'[Date]))
		displayFolder: PYs
		lineageTag: e570bb66-605c-4192-9ff3-c4ef4819916b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Total Transactions for the same period in the prior year using SAMEPERIODLASTYEAR. Returns blank if prior-year dates are outside the dim_Date range.
	measure 'PY Transactions' = CALCULATE([Total Transactions], SAMEPERIODLASTYEAR('dim_Date'[Date]))
		formatString: 0
		displayFolder: PYs
		lineageTag: 1a426b8f-7f9c-4079-989c-9bedb56cffd8

	/// Average Transaction Value for the same period in the prior year using SAMEPERIODLASTYEAR. Returns blank if prior-year dates are outside the dim_Date range.
	measure 'PY Average Transaction Value' = CALCULATE([Average Transaction Value], SAMEPERIODLASTYEAR('dim_Date'[Date]))
		displayFolder: PYs
		lineageTag: f37332a3-ab20-4be2-807c-60d98977ee50

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Year-over-year change in Total Amount (current period minus prior year). Positive = growth; negative = decline. Returns blank when PY Amount is blank.
	measure 'YOY Amount' = [Total Amount] - [PY Amount]
		displayFolder: YOYs
		lineageTag: 277697a7-0519-4716-968d-a61836db6bfa

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Year-over-year change in Total Fees (current period minus prior year). Returns blank when PY Fees is blank.
	measure 'YOY Fees' = [Total Fees] - [PY Fees]
		displayFolder: YOYs
		lineageTag: 87388143-fb00-4cd6-8c31-30790498efdf

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Year-over-year change in Total Tax (current period minus prior year). Returns blank when PY Tax is blank.
	measure 'YOY Tax' = [Total Tax] - [PY Tax]
		displayFolder: YOYs
		lineageTag: e12ae2c0-c1fa-4296-8665-59b7860fd46d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Year-over-year change in Total Transactions (current period minus prior year). Returns blank when PY Transactions is blank.
	measure 'YOY Transactions' = [Total Transactions] - [PY Transactions]
		formatString: 0
		displayFolder: YOYs
		lineageTag: 55b999ac-a3a2-41e2-9cae-0b6009cdf014

	/// Year-over-year change in Average Transaction Value (current period minus prior year). Returns blank when PY Average Transaction Value is blank.
	measure 'YOY Average Transaction Value' = [Average Transaction Value] - [PY Average Transaction Value]
		displayFolder: YOYs
		lineageTag: 306ec007-85ca-4550-897a-4a59ce5da0e6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Year-over-year percentage growth in Total Amount. Calculated as YOY Amount divided by PY Amount using DIVIDE (returns 0 on division by zero). Formatted as percentage.
	measure 'YOY% Amount' = DIVIDE([YOY Amount], [PY Amount])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: YOY%s
		lineageTag: c62d7ae8-9e3f-4322-9d94-e396097729a2

	/// Year-over-year percentage growth in Total Fees. Calculated as YOY Fees divided by PY Fees using DIVIDE. Formatted as percentage.
	measure 'YOY% Fees' = DIVIDE([YOY Fees], [PY Fees])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: YOY%s
		lineageTag: 408e69de-d57c-4d57-b02e-534dc19ea849

	/// Year-over-year percentage growth in Total Tax. Calculated as YOY Tax divided by PY Tax using DIVIDE. Formatted as percentage.
	measure 'YOY% Tax' = DIVIDE([YOY Tax], [PY Tax])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: YOY%s
		lineageTag: a02b1cdc-f39b-41e5-a128-cd7f38496fd2

	/// Year-over-year percentage growth in Total Transactions. Calculated as YOY Transactions divided by PY Transactions using DIVIDE. Formatted as percentage.
	measure 'YOY% Transactions' = DIVIDE([YOY Transactions], [PY Transactions])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: YOY%s
		lineageTag: 4608638d-163b-472f-8cd8-87ac2b18c211

	/// Year-over-year percentage growth in Average Transaction Value. Calculated as YOY Average Transaction Value divided by PY Average Transaction Value using DIVIDE. Formatted as percentage.
	measure 'YOY% Average Transaction Value' = DIVIDE([YOY Average Transaction Value], [PY Average Transaction Value])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: YOY%s
		lineageTag: b5c4d70a-2406-4b14-a23b-824bc9a9cb27

	/// Dynamic chart title for the monthly trend visual. Returns a label matching the active metric selected in the _Metrics field parameter slicer. Falls back to 'Financial Metric by Month' when no single metric is selected.
	measure 'Dynamic Month Chart Title' =
			VAR SelectedMetricOrder = SELECTEDVALUE('_Metrics'[_Metrics Order])
			RETURN
			    SWITCH(
			        SelectedMetricOrder,
			        0, "Total Amount by Month",
			        1, "Total Fees by Month",
			        2, "Total Tax by Month",
			        3, "Total Transactions by Month",
			        "Financial Metric by Month"
			    )
		displayFolder: Dynamic Titles
		lineageTag: 309b1a7a-b271-47c3-911e-1f768cec3c76

	/// Dynamic chart title for the Transaction Status breakdown visual. Returns a label matching the active metric in the _Metrics slicer. Falls back to 'Financial Metric by Transaction Status' when no single metric is selected.
	measure 'Dynamic Transaction Status Chart Title' =
			VAR SelectedMetricOrder = SELECTEDVALUE('_Metrics'[_Metrics Order])
			RETURN
			    SWITCH(
			        SelectedMetricOrder,
			        0, "Total Amount by Transaction Status",
			        1, "Total Fees by Transaction Status",
			        2, "Total Tax by Transaction Status",
			        3, "Total Transactions by Transaction Status",
			        "Financial Metric by Transaction Status"
			    )
		displayFolder: Dynamic Titles
		lineageTag: f4f4c617-508b-4092-a01c-059b5492ae6c

	/// Dynamic chart title for the Customer Segment breakdown visual. Returns a label matching the active metric in the _Metrics slicer. Falls back to 'Financial Metric by Customer Segment' when no single metric is selected.
	measure 'Dynamic Customer Segment Chart Title' =
			VAR SelectedMetricOrder = SELECTEDVALUE('_Metrics'[_Metrics Order])
			RETURN
			    SWITCH(
			        SelectedMetricOrder,
			        0, "Total Amount by Customer Segment",
			        1, "Total Fees by Customer Segment",
			        2, "Total Tax by Customer Segment",
			        3, "Total Transactions by Customer Segment",
			        "Financial Metric by Customer Segment"
			    )
		displayFolder: Dynamic Titles
		lineageTag: b1c3abd5-7aaf-45f0-952e-d2dd39c7e495

	/// Dynamic chart title for the State breakdown visual. Returns a label matching the active metric in the _Metrics slicer. Falls back to 'Financial Metric by State' when no single metric is selected.
	measure 'Dynamic State Chart Title' =
			VAR SelectedMetricOrder = SELECTEDVALUE('_Metrics'[_Metrics Order])
			RETURN
			    SWITCH(
			        SelectedMetricOrder,
			        0, "Total Amount by State",
			        1, "Total Fees by State",
			        2, "Total Tax by State",
			        3, "Total Transactions by State",
			        "Financial Metric by State"
			    )
		displayFolder: Dynamic Titles
		lineageTag: ce1cbdd6-c138-411e-bbe3-ee674ae353a9

	/// Dynamic chart title for the Gender breakdown visual. Returns a label matching the active metric in the _Metrics slicer. Falls back to 'Financial Metric by Gender' when no single metric is selected.
	measure 'Dynamic Gender Chart Title' =
			VAR SelectedMetricOrder = SELECTEDVALUE('_Metrics'[_Metrics Order])
			RETURN
			    SWITCH(
			        SelectedMetricOrder,
			        0, "Total Amount by Gender",
			        1, "Total Fees by Gender",
			        2, "Total Tax by Gender",
			        3, "Total Transactions by Gender",
			        "Financial Metric by Gender"
			    )
		displayFolder: Dynamic Titles
		lineageTag: 897fe5b7-ae37-4fc2-963a-dd0c80087175

	/// Dynamic page heading for the Transaction Details drill-through page. Shows the active customer segment filter when exactly one segment is selected; falls back to 'All Segments' when multiple or no segments are in context.
	measure 'Page Title' =
			VAR SingleSegment = HASONEVALUE(dim_Customer[Customer Segment])
			VAR SegmentName = VALUES(dim_Customer[Customer Segment])
			RETURN
			    "Transaction Details: " & IF(SingleSegment, SegmentName, "All Segments")
		displayFolder: Dynamic Titles
		lineageTag: 8d8794e2-e8bb-45af-9d6a-524835f9d782

	/// Count of distinct customers with transactions in the current filter context. Used on the Monthly State Tooltip page to show active customer density per state and month. Counts Customer IDs present in fact_Transactions — customers with no transactions are excluded.
	measure 'ToolTip Customers' =
			VAR DistinctCustomers = CALCULATE(DISTINCTCOUNT(fact_Transactions[Customer ID]))
			RETURN DistinctCustomers
		formatString: 0
		displayFolder: Tooltip
		lineageTag: 80f601a1-4b4d-4b97-b5b7-0cf5a63b1b1d

	partition _Measures = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Column1"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

