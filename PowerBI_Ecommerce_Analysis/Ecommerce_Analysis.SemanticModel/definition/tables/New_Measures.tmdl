table New_Measures
	lineageTag: d58e0f32-9c73-476c-a8e7-a8476bffca78

	measure 'Number of Customers' = DISTINCTCOUNTNOBLANK(Sales[Customer ID])
		formatString: 0
		lineageTag: fb191a4b-03f0-4355-b663-09c7628d42ab

	measure 'Customer LTV (avg)' = SUM(Sales[Sales])/[Number of Customers]
