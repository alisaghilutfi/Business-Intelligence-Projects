/// What-if parameter table for the quantity tier slicer. Used to drive the Blended Shipping Cost Factor and Shipping (What-if) measures. The What-if quantity column provides the slicer values (1–10).
table 'What-if quantity'
	lineageTag: 877f5b89-6131-4f82-bfad-c10582a4e1d2

	/// Returns the currently selected quantity tier from the What-if quantity slicer. Defaults to 5 when nothing is selected.
	measure 'What-if quantity Value' =
			VAR SelectedQty = SELECTEDVALUE('What-if quantity'[What-if quantity], 5)
			RETURN
			    SelectedQty
		formatString: 0
		displayFolder: What-if
		lineageTag: cfc37dba-000e-43fe-bc74-681d5c6750e0

	/// Tiered discount factor applied to additional units beyond the first in the what-if shipping scenario. Tiers: 1 unit=1.0 (no discount), 2 units=0.8, 3–4=0.6, 5–7=0.5, 8–9=0.4, 10+=0.3.
	measure 'Blended Shipping Cost Factor' =
			VAR Qty = [What-if quantity Value]
			VAR Factor =
			    IF(Qty <= 1, 1,
			    IF(Qty <= 2, 0.8,
			    IF(Qty <= 4, 0.6,
			    IF(Qty <= 7, 0.5,
			    IF(Qty <= 9, 0.4,
			       0.3)))))
			RETURN
			    Factor
		displayFolder: What-if
		lineageTag: 93eba94b-fa6c-4006-8eab-1730d1364560

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'What-if quantity'
		formatString: 0
		lineageTag: 5bfde7ab-b806-4155-a155-189d2cc5dcd0
		summarizeBy: none
		sourceColumn: [Value]

		extendedProperty ParameterMetadata =
				{
				  "version": 0
				}

		annotation SummarizationSetBy = User

	partition 'What-if quantity-8f133ef9-b1ca-44bf-9c94-f01fca6323b7' = calculated
		mode: import
		source = GENERATESERIES(1, 20, 1)

	annotation PBI_Id = abeb38ac8fd347c885876e625eaadbfe

