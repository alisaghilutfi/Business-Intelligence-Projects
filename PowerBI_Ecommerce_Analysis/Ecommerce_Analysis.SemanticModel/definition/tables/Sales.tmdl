table Sales
	lineageTag: 24ef9dec-5759-49ec-a242-42b449b59d51

	measure Total_Rows = COUNTROWS(Sales)
		formatString: 0
		lineageTag: 79c9501f-3df4-4eae-918e-964111d1b487

	measure 'Shipping (Baseline)' = SUMX(Sales, IF(Sales[Quantity]=1,Sales[Shipping Cost],Sales[Shipping Cost]+(((Sales[Quantity])-1)*(Sales[Shipping Cost]*0.7))))
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 4ce7fb25-dc74-4ef0-a16f-43f7d3665a53

	measure 'Shipping (What-if)' = SUMX(Sales,IF(Sales[Quantity]=1,Sales[Shipping Cost],Sales[Shipping Cost]+(((Sales[Quantity])-1)*(Sales[Shipping Cost]*[Blended Shipping Cost Factor]))))
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: ee19cd41-4ec2-440d-b4c3-2507217420cb

	measure 'Shipping (Difference)' = [Shipping (Baseline)] - [Shipping (What-if)]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 07a4163c-1136-472a-a802-5f7a0d694757

	measure 'Baseline running total' = SUMX(FILTER(ALLSELECTED(Sales), Sales[Transaction Date] <=MAX('Market Basket'[Transaction Date])), [Shipping (Baseline)])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: dc4b5dbc-da47-46c9-b51f-acb6f2517902

	measure 'What-if running total' = SUMX(FILTER(ALLSELECTED(Sales), Sales[Transaction Date] <=MAX('Market Basket'[Transaction Date])), [Shipping (What-if)])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: af65176d-21ed-402c-ab22-d39bd7da29bf

	measure 'Difference running total' = SUMX(FILTER(ALLSELECTED(Sales), Sales[Transaction Date] <=MAX('Market Basket'[Transaction Date])), [Shipping (Difference)])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
