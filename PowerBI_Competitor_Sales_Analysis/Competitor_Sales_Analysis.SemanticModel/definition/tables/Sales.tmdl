table Sales
	lineageTag: 1614289d-2d07-4c5f-bedd-01b55c65033a

	measure 'PY Sales' =
			CALCULATE (
			    SUM (Sales[Revenue]),
			    SAMEPERIODLASTYEAR ( 'Date'[Date] )
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 3dd2022e-bcb4-4ea0-8d99-14c5b77ebece

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure '% Growth' =
			
			DIVIDE(
			SUM(Sales[Revenue])-[PY Sales],[PY Sales]
			)
		formatString: #,0.00%;-#,0.00%;#,0.00%
		lineageTag: 6d8f95a7-18ca-48e2-9dfb-a0cfc6adea81

		changedProperty = FormatString

	measure 'Sintec Revenue' =
			Calculate(
			SUM(Sales[Revenue]), Manufacturer[ManufacturerID] = 4
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 7e6e725a-0551-4aca-990e-0b7cff200e9b

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Sintec Market Share' =
			DIVIDE(
			Sales[Sintec Revenue],SUM(Sales[Revenue]),0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 0d4b4ca7-061f-4c87-905c-37452b3d795f

		changedProperty = FormatString

