#!/bin/sh
# PBIP profile pre-commit -- warns on modified Desktop-managed TMDL, blocks local-state files and secrets.

# database.tmdl / model.tmdl are required PBIP files owned by Power BI Desktop.
# Added files pass. Modified files warn only (does not block).
TMDL_PAT='(^|/)(database|model)\.tmdl$'
tmdl_mod=$(git diff --cached --name-only --diff-filter=M | grep -E "$TMDL_PAT")
if [ -n "$tmdl_mod" ]; then
  echo "Warning: Desktop-managed TMDL file(s) modified in this commit:" >&2
  echo "$tmdl_mod" | sed 's/^/  /' >&2
  echo "(Commit not blocked. Review: git diff --cached -- <file>  Unstage: git restore --staged <file>)" >&2
fi

# Block Power BI local-state files.
local_hits=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '(^|/)localSettings\.json$|(^|/)unappliedChanges\.json$')
if [ -n "$local_hits" ]; then
  echo "Blocked: localSettings.json / unappliedChanges.json are machine-local state:"
  echo "$local_hits"
  echo "Add them to .gitignore if not already present."
  exit 1
fi

# Warn on BOM in staged Report JSON files (does not block).
bom_hits=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '\.Report/.*\.json$' \
  | while read f; do
      if git show ":$f" 2>/dev/null | head -c 3 | od -An -tx1 | grep -q 'ef bb bf'; then
        echo "  $f"
      fi
    done)
if [ -n "$bom_hits" ]; then
  bom_count=$(echo "$bom_hits" | wc -l | tr -d ' ')
  echo "Warning: $bom_count staged Report JSON file(s) have a UTF-8 BOM — may cause PBIP parse errors:"
  echo "$bom_hits"
  echo "(Commit not blocked. Fix: sed -i '1s/^\xEF\xBB\xBF//' <file>)"
fi

# Secret scanning -- block Azure SP secrets, connection strings, bearer tokens.
SECRET_PAT='"client[Ss]ecret"[[:space:]]*:[[:space:]]*"[^"]{8,}"|AccountKey=[A-Za-z0-9+/]{20,}={0,2}|SharedAccessSignature=[^"&[:space:]]{20,}|[Bb]earer[[:space:]]+ey[A-Za-z0-9._-]{20,}|password[[:space:]]*=[[:space:]]*[A-Za-z0-9!@#$%^&*]{8,}'
secrets=$(git diff --cached -U0 --diff-filter=ACM \
  | grep -E '^\+' \
  | grep -ivE '^\+\+\+' \
  | grep -E "$SECRET_PAT")
if [ -n "$secrets" ]; then
  echo "Blocked: possible secrets in staged changes:"
  echo "$secrets"
  echo "Remove secrets before committing (override: git commit --no-verify)."
  exit 1
fi

exit 0
